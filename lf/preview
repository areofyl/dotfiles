#!/bin/sh

# Absolute paths keep leading '-' in filenames from becoming tool options.
case "$1" in
    /*) file="$1" ;;
    *) file="$PWD/$1" ;;
esac
w="$2"
h="$3"
x="$4"
y="$5"

mime=$(file --mime -Lb -- "$file")
type=${mime%%;*}

text_preview() {
    bat --paging=never --theme=nimbus --color=always --style=numbers,header-filename \
        --line-range=:200 --terminal-width="$w" -- "$file" 2>/dev/null \
        || { head -c 32768 -- "$file" | head -n 200 | cat -v; }
}

archive_preview() {
    printf 'archive: %s\n' "$(file --brief -- "$file")"
    if command -v bsdtar >/dev/null 2>&1; then
        bsdtar -tf "$file" 2>/dev/null
    else
        case "$type" in
            application/zip) unzip -l "$file" 2>/dev/null ;;
            application/x-7z-compressed)
                if command -v 7z >/dev/null 2>&1; then 7z l -- "$file" 2>/dev/null; fi ;;
            *) tar -tf "$file" 2>/dev/null ;;
        esac
    fi
}

case "$type" in
    image/*)
        if [ -n "${KITTY_WINDOW_ID:-}" ] && \
            kitty +kitten icat --silent --stdin no --transfer-mode file \
                --place "${w}x${h}@${x}x${y}" "$file" < /dev/null > /dev/tty; then
            exit 1
        fi
        file --brief -- "$file"
        ;;
    application/gzip|application/x-tar|application/zip|application/x-xz|application/zstd|application/x-bzip2|application/x-7z-compressed)
        archive_preview | head -c 32768 | head -n 200 | cat -v
        ;;
    application/pdf)
        file --brief -- "$file"
        ;;
    *)
        case "$mime" in
            *charset=binary) file --brief -- "$file" ;;
            *charset=*) text_preview ;;
            *) file --brief -- "$file" ;;
        esac
        ;;
esac
